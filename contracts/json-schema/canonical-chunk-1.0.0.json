      "const": "1.0.0"
    },
    "chunk_id": {
      "type": "string"
    },
    "chunk_run_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "document_version_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "embedding_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    },
    "canonical_strategy": {
      "type": "string"
    },
    "adapter_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    }
  },
  "additionalProperties": true
