# Adaptive Chunk Engine — environment example
ENVIRONMENT=development
AUTH_MODE=development
# Development auth is NOT production-safe

DATABASE_URL=postgresql+asyncpg://ace:ace@localhost:5432/ace
DATABASE_URL_SYNC=postgresql+psycopg://ace:ace@localhost:5432/ace
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ace_chunks
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=ace-documents
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACE_STORAGE_ROOT=/tmp/ace-data
# Browser uses same-origin /api/v1 (Next.js App Router proxy). Server-side upstream:
API_INTERNAL_URL=http://127.0.0.1:8000/api/v1
# Legacy / fallback upstream URL (Compose still sets this; browser does not call it directly)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

CHUNK_SIZE_DEFAULT=512
CHUNK_SIZE_MIN=128
CHUNK_SIZE_MAX=4096
CHUNK_OVERLAP_DEFAULT=64
CHUNK_OVERLAP_MAX_RATIO=0.30
CHUNK_HARD_TOKEN_LIMIT=4096
CHUNK_MAX_COUNT_PER_DOCUMENT=100000
CHUNK_MAX_CROSS_UNIT_SPAN=2
CHUNK_ALLOW_OVERSIZE_ATOMIC_BLOCK=true

QA_DEFAULT_COUNT=50
QA_MIN_COUNT=1
QA_MAX_COUNT=1000

EVAL_DEFAULT_TOP_K=10
EVAL_MAX_TOP_K=100
EVAL_TARGET_RECALL_AT_10=0.95
EVAL_MIN_COMPOSITE_RELATIVE_GAIN=0.01
EVAL_MIN_RECALL_ABSOLUTE_GAIN=0.005
EVAL_CRITICAL_SEGMENT_GAIN=0.02

OPTIMIZATION_MAX_ROUNDS=10
OPTIMIZATION_REQUIRE_HUMAN_TRIGGER=true
OPTIMIZATION_ALLOW_AUTOMATIC_EXECUTION=false

ALLOW_EXTERNAL_DOCUMENT_PROVIDER=false
ALLOW_EXTERNAL_LLM_FOR_SENSITIVE_DOCS=false
STORE_LLM_PROMPT_RESPONSE=true

VISUAL_PROCESSING_ENABLED=true
SVG_GENERATION_DEFAULT=auto
SVG_MAX_SOURCE_IMAGE_PIXELS=40000000
SVG_MAX_FILE_SIZE_BYTES=10000000
SVG_MAX_ELEMENTS=10000
SVG_MAX_PATH_COMMANDS=200000
SVG_MAX_NESTING_DEPTH=32
SVG_ALLOW_EXTERNAL_REFERENCES=false
SVG_ALLOW_SCRIPTS=false
SVG_ALLOW_FOREIGN_OBJECT=false
SVG_MIN_CONFIDENCE=0.80
SVG_KEEP_ORIGINAL_RASTER=true
SVG_INDEX_RAW_XML=false

ZCHUNK_ENABLED=false
CHUNKR_BASE_URL=
MARKDOWN_STRUCTURE_SIDECAR_URL=

# Optional live providers (not required for local demo)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Live Adaptive Chunking eval via OpenRouter (`make eval-openrouter`)
ACE_CHAT_MODEL=openai/gpt-4o
ACE_EMBED_MODEL=openai/text-embedding-3-small
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_DATASET_ID=
